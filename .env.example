# Backend API URL
# Web/iOS: http://localhost:3000
# Android emulator: http://10.0.2.2:3000 (10.0.2.2 = host from emulator)
# Physical device: http://YOUR_LAN_IP:3000 (e.g. http://192.168.1.5:3000)
EXPO_PUBLIC_API_URL="http://localhost:3000"

# App role — determines which user role this frontend instance accepts.
# Must match a role registered in the backend's roles table.
# Examples: "customer", "admin", "driver"
EXPO_PUBLIC_APP_ROLE="driver"
