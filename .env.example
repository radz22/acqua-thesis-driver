# Backend API URL
# Keep localhost here. Native Expo Go rewrites it to the Metro LAN host
# (or 10.0.2.2 on the Android emulator) so the phone can reach the Mac.
EXPO_PUBLIC_API_URL="http://localhost:4000"

# App role — determines which user role this frontend instance accepts.
# Must match a role registered in the backend's roles table.
# Examples: "customer", "admin", "driver"
EXPO_PUBLIC_APP_ROLE="driver"

# Google Maps (native). Used by Expo config for iOS/Android map tiles.
# Never put this key in source files.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""
